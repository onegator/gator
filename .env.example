# gator-server
GATOR_LISTEN_ADDR=:8080
GATOR_DATABASE_URL=postgres://gator:gator@localhost:5433/gator?sslmode=disable
GATOR_LOG_LEVEL=info

# gator-runner
GATOR_RUNNER_SERVER_URL=http://localhost:8080
GATOR_RUNNER_TOKEN=
GATOR_RUNNER_NAME=
GATOR_RUNNER_LOCATION=mac
GATOR_RUNNER_WORKDIR=

# secrets at rest (gator-server): generate with `gator-server secrets new-key`
GATOR_SECRETS_KEY=
# GATOR_SECRETS_OLD_KEYS=k20260101:...,k20251201:...

# observability (gator-server)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
GATOR_RATE_LIMIT_RPS=20
GATOR_RATE_LIMIT_BURST=40

# auth (gator-server)
# GATOR_OIDC_ISSUER=https://accounts.google.com
# GATOR_OIDC_CLIENT_ID=
# GATOR_OIDC_CLIENT_SECRET=
# GATOR_OIDC_REDIRECT_URL=https://gator.example.com/auth/callback
# GATOR_INSECURE_COOKIES=1   # only over plain http locally
GATOR_DEV_AUTH=1              # trust X-Gator-User header; local development only

# backups (gator-server): hourly pg_dump to an S3-compatible bucket; unset = disabled
# GATOR_BACKUP_S3_ENDPOINT=fsn1.your-objectstorage.com
# GATOR_BACKUP_S3_BUCKET=gator-backups
# GATOR_BACKUP_S3_PREFIX=prod
# GATOR_BACKUP_S3_ACCESS_KEY=
# GATOR_BACKUP_S3_SECRET_KEY=
# GATOR_BACKUP_S3_INSECURE=1     # plain http (local minio)
# GATOR_BACKUP_KEEP=168          # keep newest N dumps
