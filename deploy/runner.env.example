# /etc/gator/runner.env — read by systemd. Mode 0600.
# Mint the token as a workspace admin: POST /api/v1/tokens {"kind":"runner","name":"vps-1"}
# Base URL of gator-server; the runner appends /api/v1/runner and switches to wss.
GATOR_RUNNER_SERVER_URL=https://gator.example.ts.net
GATOR_RUNNER_TOKEN=
GATOR_RUNNER_NAME=vps-1
GATOR_RUNNER_LOCATION=vps
GATOR_RUNNER_WORKDIR=/var/lib/gator-runner/work
# Agent backends this runner can execute: claude. Empty = online but receives no jobs.
# Log the CLI in as the runner user first: sudo -iu gator-runner claude
GATOR_RUNNER_BACKENDS=
# GATOR_RUNNER_CLAUDE_BIN=claude
# GATOR_RUNNER_CLAUDE_MODEL=
# Jobs run with --strict-mcp-config: MCP servers and claude.ai connectors of the logged-in
# account are never available. To grant an explicit set, point this at an MCP config file.
# GATOR_RUNNER_CLAUDE_MCP_CONFIG=/etc/gator/runner-mcp.json
# Push job branches to origin (needs the runner user's git credentials). 0 keeps them local.
GATOR_RUNNER_PUSH=1
GATOR_RUNNER_MAX_PARALLEL=1
# Restrict to project ids (comma-separated); empty = any project.
GATOR_RUNNER_PROJECTS=
