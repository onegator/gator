# /etc/gator/runner.env — read by systemd. Mode 0600.
# Mint the token as a workspace admin: POST /api/v1/tokens {"kind":"runner","name":"vps-1"}
# Base URL of gator-server; the runner appends /api/v1/runner and switches to wss.
GATOR_RUNNER_SERVER_URL=https://gator.example.ts.net
GATOR_RUNNER_TOKEN=
GATOR_RUNNER_NAME=vps-1
GATOR_RUNNER_LOCATION=vps
GATOR_RUNNER_WORKDIR=/var/lib/gator-runner/work
# Agent backends this runner can execute (empty = online but receives no jobs until PLQ-223).
GATOR_RUNNER_BACKENDS=
GATOR_RUNNER_MAX_PARALLEL=1
# Restrict to project ids (comma-separated); empty = any project.
GATOR_RUNNER_PROJECTS=
