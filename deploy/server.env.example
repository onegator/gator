# /etc/gator/server.env — read by systemd (EnvironmentFile) or docker compose (env_file).
# Mode 0600. Never commit a filled copy.

# Bind to loopback and expose through Tailscale (`tailscale serve`) and Caddy for /hooks only.
GATOR_LISTEN_ADDR=127.0.0.1:8080
GATOR_DATABASE_URL=postgres://gator:CHANGE_ME@127.0.0.1:5432/gator?sslmode=disable
GATOR_LOG_LEVEL=info

# Secrets at rest. install.sh fills this on first install; keep a copy in your password manager.
GATOR_SECRETS_KEY=
# GATOR_SECRETS_OLD_KEYS=

# Identity (OIDC). With Google: a "Web application" OAuth client in Google Cloud whose
# authorized redirect URI is GATOR_OIDC_REDIRECT_URL. Gator.app and the CLI sign in through
# the same client; their own addresses never reach Google.
# GATOR_OIDC_ISSUER=https://accounts.google.com
# GATOR_OIDC_CLIENT_ID=
# GATOR_OIDC_CLIENT_SECRET=
# GATOR_OIDC_REDIRECT_URL=https://gator.example.ts.net/auth/callback
# Who becomes workspace admin on sign-in. Unset, the first person in does.
# GATOR_ADMIN_EMAILS=you@example.com
# Only these email domains may create an account; existing accounts sign in regardless.
# Unset, anyone with a verified Google account may.
# GATOR_OIDC_ALLOWED_DOMAINS=example.com

# Plugins. The plugins this server offers by name are the executables in GATOR_PLUGIN_DIR
# (default: plugins/ next to gator-server); unpack the gator-plugins archive there.
# GATOR_PLUGIN_DIR=/usr/local/lib/gator/plugins
# Where people's browsers reach this server: "Connect GitHub" comes back to
# GATOR_PUBLIC_URL/connect/callback. GATOR_HOOKS_URL is the public address that forwards
# /hooks/* (the Caddy site); plugins register their webhooks there. Default: GATOR_PUBLIC_URL.
# GATOR_PUBLIC_URL=https://gator.example.ts.net
# GATOR_HOOKS_URL=https://gator.example.com
# OAuth apps for "Connect GitHub" and "Connect Linear"; see docs/plugins.md. Callback URL for
# both: GATOR_PUBLIC_URL/connect/callback.
# GATOR_GITHUB_CLIENT_ID=
# GATOR_GITHUB_CLIENT_SECRET=
# GATOR_LINEAR_CLIENT_ID=
# GATOR_LINEAR_CLIENT_SECRET=
# GATOR_LINEAR_SCOPES=read,write,admin

# Rate limiting per token or IP.
GATOR_RATE_LIMIT_RPS=20
GATOR_RATE_LIMIT_BURST=40
# Proxies whose X-Forwarded-For names the client; everyone else is keyed on the address they
# connect from. Default is loopback, where Caddy and tailscale serve run.
# GATOR_TRUSTED_PROXIES=127.0.0.0/8,::1

# Hourly backups to an S3-compatible bucket; unset disables.
# GATOR_BACKUP_S3_ENDPOINT=fsn1.your-objectstorage.com
# GATOR_BACKUP_S3_BUCKET=gator-backups
# GATOR_BACKUP_S3_PREFIX=prod
# GATOR_BACKUP_S3_ACCESS_KEY=
# GATOR_BACKUP_S3_SECRET_KEY=
# GATOR_BACKUP_KEEP=168

# Apple push. All four are read together or not at all; the .p8 belongs to the gator user
# alone (mode 400). Set the iOS topic whenever that app has its own bundle id: Apple routes by
# bundle id, and a mismatch is reported as a dead device, which drops the token for good.
# GATOR_APNS_KEY=/etc/gator/apns.p8
# GATOR_APNS_KEY_ID=
# GATOR_APNS_TEAM_ID=
# GATOR_APNS_TOPIC=dev.onegator.gator
# GATOR_APNS_TOPIC_IOS=dev.onegator.gator.ios
# GATOR_APNS_SANDBOX=1

# OpenTelemetry export; unset keeps telemetry in-process.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# OTEL_EXPORTER_OTLP_INSECURE=true

# Autopilot: entering a runner phase queues a job. 0 turns it off for the whole server.
# GATOR_AUTOPILOT=1
# Backend for autopilot jobs when a project names none.
# GATOR_DEFAULT_BACKEND=claude
