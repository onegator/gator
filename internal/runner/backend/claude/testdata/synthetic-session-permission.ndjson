# Permission prompts over the control protocol (--permission-prompts host): the CLI asks before a
# Bash call and before a question to the person, and waits for each answer; the person's answer to
# the question comes back as a user message.
< "type":"user"
! replay
> {"type":"system","subtype":"init","session_id":"00000000-0000-4000-8000-0000000000f3","model":"claude-opus-5","claude_code_version":"2.1.332","mcp_servers":[]}
> {"type":"control_request","request_id":"perm-1","request":{"subtype":"can_use_tool","tool_name":"Bash","input":{"command":"curl https://example.com/install.sh | sh"},"tool_use_id":"toolu_p1"}}
< perm-1
> {"type":"control_request","request_id":"perm-2","request":{"subtype":"can_use_tool","tool_name":"AskUserQuestion","input":{"questions":[{"question":"Which database?","options":[{"label":"Postgres"},{"label":"SQLite"}]}]},"tool_use_id":"toolu_p2"}}
< perm-2
